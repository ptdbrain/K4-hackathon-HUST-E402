# Chọn đúng một provider: OPENAI, GOOGLE, OPENROUTER hoặc OLLAMA.
# Khi đổi provider, đổi AI_MODEL thành model ID có trên tài khoản/máy của bạn.
AI_PROVIDER=GOOGLE
AI_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT=90
AI_MAX_TOKENS=1800

# Cloud keys — chỉ điền key của provider đang chọn
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# GitHub public repo reader; để trống vẫn chạy với rate limit thấp hơn
GITHUB_TOKEN=
